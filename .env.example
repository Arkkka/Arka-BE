NODE_ENV=development
HOST=0.0.0.0
PORT=4001
DATABASE_URL=postgresql://arka:change-me@127.0.0.1:5432/arka
REDIS_URL=redis://127.0.0.1:6379
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-sender@example.com
SMTP_PASSWORD=replace-with-app-password
SMTP_CONNECTION_TIMEOUT_MS=8000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=15000
BROWSER_ORIGINS=http://localhost:5174,http://localhost:4001
LOG_LEVEL=info
PREPARATION_TTL_MS=300000
BINDING_DEADLINE_MS=20000
IDEMPOTENCY_TTL_MS=86400000
DEVICE_COMMAND_TTL_MS=30000
DEVICE_SECRET_BASE64=
OLLAMA_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=replace-with-approved-model
OLLAMA_MODEL_ALLOWLIST=replace-with-approved-model
OLLAMA_TIMEOUT_MS=120000
OLLAMA_WORKER_INTERVAL_MS=5000
OLLAMA_LEASE_MS=30000
OLLAMA_MAX_ATTEMPTS=3
